# Виртуальное окружение — его можно пересоздать, а место он занимает много
.venv/
venv/
env/
ENV/

# Кэш байт-кода Python — генерируется автоматически при запуске
__pycache__/
*.py[cod]
*$py.class

# Файлы, создаваемые при сборке и установке пакетов
build/
dist/
*.egg-info/
.eggs/

# Локальные файлы с секретами и настройками для конкретного окружения
.env
*.env
*.local

# Логи и файлы отчетов о тестировании
log/
*.log
.pytest_cache/
.coverage
htmlcov/
testo.py

# Настройки вашей IDE (если вы используете, например, PyCharm или VS Code)
.vscode/
.idea/
*.swp
*.swo

# Системные файлы (особенно для macOS и Windows)
.DS_Store
Thumbs.db